{
  "name": "ai-calorie-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Offline AI calorie and fitness tracker: log Indian and global food in plain English, get macros, energy balance and a workout plan.",
  "type": "module",
  "bin": {
    "track": "./bin/track.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli": "node bin/track.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22.6"
  }
}
